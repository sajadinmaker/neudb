# neuDB API example environment — copy to .env (do NOT commit .env)
# Only the HTTP layer (neudb/api.py) reads these. Core library needs no env vars.

# Required to serve the API; requests must send X-API-Key with this value.
NEUDB_API_KEY=change-me-use-a-long-random-secret

# Directory the API stores its tables in (default: neudb_api_data/).
NEUDB_API_DB=neudb_api_data/

# Comma-separated origins allowed to call the API from the local dashboard.
NEUDB_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
